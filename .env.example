# Template: copy to .env.local and fill in the values.
# Never put real keys in this file: it is committed to git.

# Public address of the app, used in Supabase Auth email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Secret: never add the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Link guest requests to accounts with a verified email.
# Keep false until email confirmation is enabled in Supabase.
LINK_GUEST_REQUESTS=false
